# ─────────────────────────────────────────────────────────────
# SolGit Dashboard Environment Variables (Vercel & Local)
# ─────────────────────────────────────────────────────────────

# MST Coral Testnet RPC & Network Config
NEXT_PUBLIC_MST_CHAIN_ID=54635
NEXT_PUBLIC_MST_RPC_URL=https://coralrpc.mstblockchain.com
NEXT_PUBLIC_MST_EXPLORER_URL=https://coral.mstscan.com

# Relayer Gasless Signer Private Key (Submits contract deployments on MST Coral)
PRIVATE_KEY=your_mst_coral_relayer_private_key_here

# Supabase Storage & Database Integration (Cloud Sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Groq AI Fixer LLM API Key (Optional for on-demand synthesis)
GROQ_API_KEY=your_groq_api_key_here

